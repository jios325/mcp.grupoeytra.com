# URL pública del servidor, sin barra final. Es el issuer de OAuth; el conector se agrega con <esta URL>/mcp.
MCP_PUBLIC_URL=http://localhost:8330
PORT=8330
# En Docker: 0.0.0.0 (el compose publica solo en 127.0.0.1 del servidor).
HOST=127.0.0.1
# Hosts extra aceptados en el encabezado Host, separados por coma (el de MCP_PUBLIC_URL ya va incluido).
MCP_ALLOWED_HOSTS=

# Sitio público del que salen llms.txt y las páginas.
EYTRA_SITE_URL=https://grupoeytra.com

# Supabase del CMS: misma URL y llave publicable que NEXT_PUBLIC_SUPABASE_* de cms.grupoeytra.com.
SUPABASE_URL=http://localhost:8300
SUPABASE_PUBLISHABLE_KEY=

# API del asistente del CMS y la llave creada en CMS › Asistente IA › Acceso a la API (nombre: «MCP»).
EYTRA_ASSISTANT_URL=http://localhost:3300/api/v1/assistant
EYTRA_ASSISTANT_KEY=

# Secreto para firmar los access tokens del MCP (openssl rand -hex 32). Cambiarlo cierra todas las sesiones.
MCP_TOKEN_SECRET=

# SQLite con clientes OAuth, códigos y refresh tokens (en Docker vive en el volumen /app/data).
MCP_DB_PATH=./data/mcp.sqlite

# Hosts https a los que puede volver el login (redirect_uri): Claude y ChatGPT. localhost siempre se admite (Claude Code).
MCP_REDIRECT_HOSTS=claude.ai,claude.com,chatgpt.com

# Encabezado con la IP real que pone el proxy de confianza (Apache: x-forwarded-for). Vacío en local.
CLIENT_IP_HEADER=
